# MongoDB connection string for a user with least-privilege access to this app's database only.
# Example: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=

# Port the server listens on. Railway sets this automatically in production — leave unset there.
PORT=3000

# development | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API in production.
# Needed whenever the frontend is hosted separately from this Express app
# (e.g. a Vercel-hosted frontend calling a Railway-hosted backend).
# Example: https://your-frontend-domain.com,https://another-domain.com
ALLOWED_ORIGINS=

# Shared secret required (as `Authorization: Bearer <ADMIN_KEY>`) to access
# admin-only routes: GET /api/students (full roster), DELETE /api/students/:kid,
# DELETE /api/students. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Treat it like a password — rotate it if it's ever exposed.
ADMIN_KEY=

# Public URL of the deployed frontend. Used to build the deep link encoded in
# each student's QR code (e.g. https://your-frontend.vercel.app/?kid=KID001).
# If unset, the QR code just encodes the bare KID instead of a link.
PUBLIC_APP_URL=
