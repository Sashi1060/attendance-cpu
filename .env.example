# MongoDB connection string for a user with least-privilege access to this app's database only.
# Example: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=

# Port the server listens on. Railway sets this automatically in production — leave unset there.
PORT=3000

# development | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API in production.
# Only needed if the frontend is hosted separately from this Express app.
# Example: https://your-frontend-domain.com,https://another-domain.com
ALLOWED_ORIGINS=
